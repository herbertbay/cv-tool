# Copy to .env and fill in your keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Auth: set a random secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=dev-secret-change-in-production

# Resend — welcome email on signup (https://resend.com/api-keys)
# Set these on the Python API service (Railway: backend), NOT on the Next.js frontend.
# On API boot you should see: "Resend: welcome email enabled" or a warning if vars are missing.
# After signup, logs: "Welcome email: sending via Resend" / "Resend API OK" or Resend error body.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Links in emails (optional; falls back to FRONTEND_URL or https://optimal.cv)
PUBLIC_SITE_URL=
